{
  "name": "para",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/copy-assets.mjs && next dev",
    "build": "node scripts/copy-assets.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "bot:dev": "tsx watch --env-file-if-exists=.env bot/index.ts",
    "bot:start": "tsx bot/index.ts",
    "schedule:import": "tsx --env-file-if-exists=.env scripts/schedule-import.ts",
    "import:tg": "tsx --env-file-if-exists=.env scripts/import-tg.ts",
    "build:scripts": "esbuild bot/index.ts scripts/migrate.ts scripts/schedule-import.ts scripts/import-tg.ts --bundle --external:sharp --external:heic-decode --external:libheif-js --platform=node --target=node24 --format=cjs --keep-names --outdir=dist --out-extension:.js=.cjs --log-level=warning"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.3",
    "grammy": "1.46.0",
    "heic-decode": "^2.1.0",
    "lucide-react": "1.52.0",
    "next": "16.3.8",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "postgres": "3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.19.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.3",
    "vitest": "5.0.3"
  }
}
