# --- Site -------------------------------------------------------------------
# Local Postgres from docker-compose.yml
DATABASE_URL=postgres://para:para@localhost:5432/para
# Public URL of the site (used in bot messages and links)
APP_URL=http://localhost:3000
# Where uploaded photos and files are stored
STORAGE_DIR=./storage
# Shared secret for signing site <-> bot requests (same value for both, 32+ chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOT_API_SECRET=
# Bot username without @, used for t.me login links (M1)
TELEGRAM_BOT_USERNAME=

# --- Bot --------------------------------------------------------------------
# Token from @BotFather. Never commit, never log.
TELEGRAM_BOT_TOKEN=
# Where the bot reaches the site API
SITE_API_URL=http://localhost:3000
