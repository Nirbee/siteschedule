# --- Site -------------------------------------------------------------------
# Local Postgres from docker-compose.yml
DATABASE_URL=postgres://para:para@localhost:5432/para
# Connection pool size (set 1 when using a PGlite dev server instead of Docker Postgres)
DATABASE_POOL_MAX=10
# Public URL of the site (used in bot messages, QR codes and login links)
APP_URL=http://localhost:3000
# Where uploaded photos and files are stored
STORAGE_DIR=./storage
# Shared secret for signing site <-> bot requests (same value for both, 32+ chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOT_API_SECRET=
# Bot username without @, used for t.me login links
TELEGRAM_BOT_USERNAME=
# Comma-separated Telegram user ids that become admins on login (bootstraps the first admin)
ADMIN_TELEGRAM_IDS=
# Dev only: grant access when the bot cannot check chat membership (TELEGRAM_CHAT_ID not set).
# Refused in production.
ACCESS_WITHOUT_CHAT_CHECK=false

# --- Bot --------------------------------------------------------------------
# Token from @BotFather. Never commit, never log.
TELEGRAM_BOT_TOKEN=
# Where the bot reaches the site API
SITE_API_URL=http://localhost:3000
# Public site address for links in bot messages (defaults to SITE_API_URL)
SITE_PUBLIC_URL=
# Course group chat id (negative number). The bot prints it when added to the group.
TELEGRAM_CHAT_ID=
